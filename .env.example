# GitHub OAuth App credentials (used only by the api/ serverless functions).
# Never commit real values — set these in Vercel Project Settings > Environment Variables.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional: restrict OAuth to this repo's org/owner (informational, checked in api/callback.js)
GITHUB_REPO_OWNER=haroonahmedd93-code
GITHUB_REPO_NAME=portfolio

# Base URL of the deployed site (used to build the OAuth callback URL)
SITE_URL=https://portfolio-one-kohl-91.vercel.app
